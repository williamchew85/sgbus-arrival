# LTA DataMall account key (required). Get one at https://datamall.lta.gov.sg/
# This stays server-side only and is NEVER sent to the browser display.
LTA_ACCOUNT_KEY=

# HTTP server port (optional, default 3000)
PORT=3000

# Bind host (optional, default 127.0.0.1 = localhost only).
# Set to 0.0.0.0 to also view the display from another device on your LAN (e.g. a phone).
HOST=127.0.0.1

# Poll interval in seconds for refreshing LTA data (optional, default 25).
POLL_INTERVAL_SECONDS=25

# Path to the stops config JSON (optional, default ./config/stops.json)
STOPS_CONFIG=./config/stops.json
