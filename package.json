{
  "name": "sgbus-arrival",
  "version": "0.1.0",
  "private": true,
  "description": "Live Singapore bus arrival display for a Raspberry Pi kiosk, sourced from LTA DataMall.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node --experimental-strip-types src/index.ts",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
